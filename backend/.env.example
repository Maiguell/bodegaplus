# Ambiente de DESARROLLO — copia este archivo como backend/.env
# Nunca subas archivos .env con claves reales al repositorio.
NODE_ENV=development
PORT=8080

# Secreto para firmar los JWT (si lo dejas vacío se genera uno aleatorio en cada arranque)
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bodega_sneakers

# Origen del frontend de Vite
CORS_ORIGIN=http://localhost:5173

# Respaldos (opcional en desarrollo)
BACKUP_ENABLED=false
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
