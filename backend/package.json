{
  "name": "bodega-admin-backend",
  "version": "1.0.0",
  "description": "Backend API REST para el sistema de Bodega y Administración",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "respaldo": "node scripts/respaldo.js",
    "restaurar": "node scripts/restaurar.js",
    "escenarios": "node scripts/escenarios.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:integracion": "node --test --test-reporter=spec --test-concurrency=1 \"tests/integracion/**/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=utils/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/unit/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
