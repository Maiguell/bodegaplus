# Ambiente de PRUEBAS — copia como backend/.env.test y arranca con NODE_ENV=test
# Usa una base separada: las pruebas registran movimientos que no se pueden borrar (kardex inmutable).
NODE_ENV=test
PORT=8090
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bodega_sneakers_test
CORS_ORIGIN=http://localhost:5173
BACKUP_ENABLED=false
