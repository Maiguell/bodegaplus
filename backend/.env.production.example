# Ambiente de PRODUCCIÓN — referencia de las variables que debes definir en el panel del hosting
# (Railway, Render, etc.). No crees este archivo con valores reales dentro del repositorio.
# El servidor NO arranca si falta JWT_SECRET, DB_HOST, DB_USER o DB_PASSWORD.
NODE_ENV=production
PORT=8080

# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Base de datos MySQL 8 en la nube
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bodega_sneakers
# La mayoría de proveedores exigen TLS
DB_SSL=true

# Si el frontend se sirve desde el mismo backend (Dockerfile), CORS no es necesario.
# Si el frontend vive en otro dominio, ponlo aquí (separa varios con comas).
CORS_ORIGIN=

# Usuarios iniciales (solo se usan la primera vez, cuando la base está vacía)
SEED_DEMO=true
SEED_ADMIN_PASSWORD=
SEED_OPERADOR_PASSWORD=

# Respaldo diario con retención de 30 días (además de los respaldos automáticos del proveedor)
BACKUP_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=3
INDICADORES_HOUR=2
